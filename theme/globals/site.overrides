@import '../extras/tocnav';

.ui.button.primary {
  background-color: @primaryColor !important;
}

.ui.button.primary.inverted:not(:hover) {
  background-color: transparent !important;
}

.ui.button.primary.inverted:focus {
  background-color: @primaryColor !important;
}

.grid .nine.wide.content-body {
  .full-width {
    @media only screen and (min-width: @largestMobileScreen) {
      left: 67% !important;
    }
  }
}

.sidebar-container-enter-done {
  z-index: 10000 !important;
}

.blue-text {
  color: @primaryColor;
}

.grey-text {
  color: @grey;
  font-size: 12px !important;
  font-weight: 400;
  text-transform: uppercase;
}

// Search block overrides to color
body.searchlib-page .searchlib-block .back-link {
  display: none;
}

.sui-search-box .search-input .terms-box .terms-box-left,
.sui-search-box .search-input .terms-box input {
  border-bottom: 2px solid @secondaryColor !important;
}

.sui-search-box .search-input .terms-box .terms-box-left .search-icon svg {
  fill: @secondaryColor !important;
}

.sui-search-box .search-input .input-controls i.close.icon,
.search-body-footer .ui.button.pagination-item.active,
.searchlib-block .dropdown-facets-list .dropdown-facet .facet-title i.icon,
.searchlib-block .dropdown-facets-list .ui.button.sui-button,
.searchlib-block
  .dropdown-facets-list
  .dropdown-facet
  .ui.button.basic.facet-btn.active
  > .facet-title,
body.searchlib-page
  .searchlib-block
  .above-results
  .sorting
  .inline.dropdown
  > span {
  color: @secondaryColor !important;
}

.sui-search-box .search-input .input-controls i.close.icon:before,
.sui-search-box .search-input .input-controls i.close.icon:after,
body.searchlib-page
  .searchlib-block
  .ui.segment.active-filter-list
  .ui.label.filter-value
  i.close.icon:before,
body.searchlib-page
  .searchlib-block
  .ui.segment.active-filter-list
  .ui.label.filter-value
  i.close.icon:after {
  background-color: @secondaryColor !important;
}

.block.search .ui.accordion.filter-listing .filter-list-group .ui.label {
  background-color: @secondaryColor !important;
}

.search-body-footer .ui.button.pagination-item.active:after {
  border-bottom: 5px solid @secondaryColor !important;
}

// hide +More filters
section .searchlib-block .ui.button.sui-button.basic {
  display: none;
}

.sui-search-box .search-input .input-controls .clear-button {
  border: 2px solid @secondaryColor !important;
}

// Geolocation widget
ul.metadata.geolocation-widget {
  grid-template-columns: max-content max-content;

  li {
    margin-right: 4.25rem;
  }
}

// Custom page header
body.custom-page-header {
  #page-header {
    .column-blocks-wrapper,
    .content-box {
      margin-bottom: 0;
    }

    .country-header-block {
      padding-right: 1em;
    }

    .country-flag {
      padding-left: 1.25rem;
    }
  }
}

body.custom-page-header .breadcrumbs {
  background-color: #e6e7e8 !important;

  .ui.breadcrumb ol li {
    vertical-align: middle;
  }

  .ui.breadcrumb a.section {
    vertical-align: text-bottom;
  }

  .ui.breadcrumb .section.active {
    vertical-align: text-bottom;
  }
}

// Fix block width when used as page header
#page-header .styled-group.has--useAsPageHeader--true {
  margin-left: auto;
  margin-right: auto;
  width: 100%;
}

@media only screen and (max-height: @tabletBreakpoint) {
  #toolbar .toolbar-content.show {
    max-height: 700px !important;
    z-index: 5;
  }
}

// WFD country profile custom classes
.gray-tab-background .RRT__panel.ui.attached.segment.tab.content.active {
  background-color: #f9f9f9;
}

.small-line-height p {
  line-height: 1.1;
}
.medium-line-height p {
  line-height: 1.3;
}

.no-margin-column {
  div.column-blocks-wrapper,
  div.ui.one.statistics {
    margin: 0 !important;
  }
}

// DWD country profile custom classes
.dwd-table .ui.table {
  border: 1px solid #004b80;
  border-collapse: separate;
  border-spacing: 0;

  thead {
    tr th {
      background-color: #004b80;
      color: white;
      border: none !important;
    }
  }

  tbody {
    tr {
      background-color: white;
      &:hover {
        background-color: white;
      }
    }

    tr:nth-child(2n) {
      background-color: #f9f9f9;
      &:hover {
        background-color: #f9f9f9;
      }
    }

    tr td {
      border-left: none !important;
      border-top: 1px solid #e5e5e5;
    }
  }
}

@media print {
  .contenttype-country_factsheet__wfd_,
  .contenttype-country_profile {
    .content-box {
      break-inside: unset;
    }

    a[title*='feedback'],
    .page-banner-actions-block,
    .styled-dividerBlock,
    .ui.breadcrumb {
      display: none;
    }

    .ui.basic.segment.content-area {
      margin-top: 1em;
    }

    .block.maps iframe,
    .print-map-preview {
      height: 400px !important;
    }

    .ui.twelve.wide.column.grid.column-grid {
      width: 100% !important;
    }

    .columns-view .column-blocks-wrapper {
      box-sizing: border-box;
      padding-right: 1em !important;
      padding-left: 1em !important;
    }

    .ui.grid > .row > .column-blocks-wrapper,
    .column-blocks-wrapper {
      margin-bottom: 15px;
    }
  }

  #page-header {
    break-inside: avoid;
  }

  // Country profiles print styles
  .contenttype-country_factsheet__wfd_ {
    .gray-tab-background .RRT__panel.ui.attached.segment.tab.content.active {
      background-color: none !important;
    }

    .ui.small.statistics .statistic > .value,
    .ui.small.statistic > .value {
      font-size: 2rem !important;
    }

    .tabs-block {
      margin-top: 2em;

      .RRT__container .ui.RRT__tabs .title {
        display: none !important;
      }

      .tab-name::before {
        font-size: 22px;
      }
    }

    .RRT__container {
      .ui.menu[class*='ary']:not(.vertical):before {
        border: none;
      }
    }

    .RRT__panel.ui.attached.segment.tab.content,
    .RRT__panel.ui.attached.segment.tab.content > div,
    .ui.statistic,
    .six.wide.column {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    div.rah-static.rah-static--height-zero {
      break-inside: avoid;
      page-break-inside: avoid;
      overflow: visible !important;
    }

    .RRT__panel.ui.attached.segment.tab.content {
      .block.call-to-action.align.left {
        margin-top: 1em;
      }

      .tab-name {
        font-weight: 500;
      }
    }
    .ui.statistics {
      margin: 0 !important;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .ui.twelve.column.grid.column-grid {
      > .six.wide.column:not(:last-child) {
        margin-bottom: 0 !important;
      }
    }

    .tabs-block .tab-name > div {
      border-top: none !important;
    }

    .tabs-block .tab-name > div {
      border-top: none;
    }
    .content-box {
      margin-left: 0 !important;
      margin-right: 0 !important;
    }

    .has--useAsPageHeader--true {
      .content-box {
        // max-height: 600px;

        .columns-view > .ui.twelve.column {
          > .eight.wide.column,
          > .four.wide.column {
            width: 100% !important;
          }

          .primary-big-text {
            font-size: 30px;
          }

          .fw-light {
            font-size: 22px;
          }

          .six.wide.column
            > .columns-view
            > .ui.twelve.column
            > .six.wide.column {
            padding: 10px;

            p.styled-slate:first-child {
              padding: 15px !important;
              margin: 0 !important;
              height: 200px;
              width: 100%;
            }

            p.styled-slate.has--fontSize--small.styled.text-center {
              display: none;
            }
          }
        }
      }
    }
  }
}
